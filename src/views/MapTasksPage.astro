---
import { routeLocale, uiFor } from '../lib/locale';
import SkillMapPage from '../components/SkillMapPage.astro';
import { taxonomyLang, textLang, orderedJourneys, mapLink as canonicalMapLink, type SkillMap } from '../lib/skill-maps';
const locale = routeLocale(Astro.url);
const ui = uiFor(locale);

interface Props { map: SkillMap }
const { map } = Astro.props;
const journeys = orderedJourneys(map).filter((j) => j.status === 'active');


const mapLink = (map: string, suffix = "") => canonicalMapLink(map, suffix, locale);
---
<SkillMapPage map={map} title={map.data.title} titleLanguage={textLang(map.data, "title")} description={map.data.summary} section="tasks">
  <p class="map-summary" lang={textLang(map.data, "summary")}>{map.data.summary}</p>
  <h2 lang={locale}>{ui('What do you want to accomplish?')}</h2>
  <div class="map-journeys">{journeys.map((journey) => <a class="map-journey" href={mapLink(map.id, `journeys/${journey.id}/`)}><h3 lang={textLang(journey, "title")}>{journey.title}</h3><p lang={textLang(journey, "summary")}>{journey.summary}</p><p class="map-scope"><span lang={locale}>{ui('Outputs: ')}</span>{journey.outputs.map((text, i) => <>{i > 0 && ' / '}<span lang={textLang(journey, `outputs.${i}`)}>{text}</span></>)}</p></a>)}</div>
  {journeys.length === 0 && <p><span lang={locale}>{ui('This map has no task journeys yet.')}</span><a href={mapLink(map.id, 'nodes/')}>{ui("Browse all items")}</a> {ui("to choose an entry.")}</p>}
  <section class="map-reading"><h2 lang={locale}>{ui('How to read this ecosystem')}</h2><p>{(map.data.taxonomy.layers.length ? map.data.taxonomy.layers : map.data.taxonomy.types).map((item, i) => <>{i > 0 && (map.data.taxonomy.layers.length ? ' → ' : ' / ')}<span lang={taxonomyLang(map, map.data.taxonomy.layers.length ? 'layers' : 'types', item.id, 'label')}>{item.label}</span></>)}</p><p lang={locale}>{ui('Task journeys guide selection; item details explain relationships between capabilities and principles.')}</p><a href={mapLink(map.id, 'overview/')}>{ui("Explore the structure")}</a></section>
</SkillMapPage>
