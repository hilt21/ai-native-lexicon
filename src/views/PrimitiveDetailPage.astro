---
import { getLocalizedCatalog, getLocalizedConcepts, getLocalizedPrimitives, unitLang } from '../lib/localized-catalog';
import { routeLocale, localePath, uiFor } from '../lib/locale';
import StarlightPage from '../components/LocalizedPage.astro';
import RecordNavigation from '../components/RecordNavigation.astro';
import CopyDefinition from '../components/CopyDefinition.astro';
import SpeakingCardLinks from '../components/SpeakingCardLinks.astro';
import { getSpeakingCards } from '../lib/speaking-cards';
import { primitiveLayerId, primitiveOwners, primitivePriorities } from '../lib/primitive-presentation';
const locale = routeLocale(Astro.url);
const ui = uiFor(locale);
const pathWithBase = (path: string) => localePath(path, locale);



const primitives = await getLocalizedPrimitives(locale);
const concepts = await getLocalizedConcepts(locale);
const primitive = primitives.find((entry) => entry.id === Astro.props.primitive.id)!;
const index = primitives.indexOf(primitive);
const previous = primitives[index - 1], next = primitives[index + 1];
const related = primitive.data.related.map((id) => primitives.find((entry) => entry.id === id)!);
const linkedConcepts = concepts.filter((entry) => entry.data.primitives.includes(primitive.id));
const definitions = primitive.definitions;
const { data } = primitive;
const layerId = primitiveLayerId(data.layer);
const layer = (await getLocalizedCatalog(locale)).layers.find((entry: { id: string }) => entry.id === layerId)!;
const owner = primitiveOwners[data.ownership.kind];
const priority = primitivePriorities[data.priority.level];
const linkedSpeakingCards = (await getSpeakingCards()).filter((card) => card.primitives.includes(primitive.id));

---

<StarlightPage frontmatter={{ title: data.term, description: data.summary, editUrl: false, tableOfContents: false }}>
  <article class="primitive-detail" aria-label={data.term}>
    <header class="concept-masthead primitive-masthead">
      <div>
        <a href={pathWithBase(`/primitives/#${layerId}`)} lang={unitLang(layer, "label")}>{layer.data.label}</a>
        <p class="concept-zh" lang="zh-CN">{data.zh}</p>
      </div>
      <div class="primitive-stamps">
        <span class="status-stamp">{data.priority.level} · {ui(priority.label)}</span>
        <span class="status-stamp">{ui(owner.label)}</span>
      </div>
    </header>

    <p class="concept-deck" lang={unitLang(primitive, "summary")}>{data.summary}</p>

    <div class="definition-grid">
      <h2>{ui("Definition / 定义")}</h2>
      <div>
        {definitions.map((definition, index) => (
          <div class="primitive-definition">
            <CopyDefinition name={`${data.term}: ${definition.name}`} statusId={`${primitive.id}-definition-copy-${index}`}><p><strong lang={definition.nameLang}>{definition.name}.</strong> <span data-definition-body lang={definition.textLang}>{definition.text}</span></p></CopyDefinition>
            {definition.concept && <a href={pathWithBase(`/concepts/${definition.concept}/`)}>{ui("Read the concept →")}</a>}
          </div>
        ))}
      </div>
    </div>

    <div class="definition-grid">
      <h2>{ui("Scope / 适用范围")}</h2>
      <p lang={unitLang(primitive, "scope")}>{data.scope}</p>
    </div>

    <div class="practice-grid primitive-practice">
      <div>
        <span>{ui("USE & COMPOSITION / 用途与组合")}</span>
        <p lang={unitLang(primitive, "usage")}>{data.usage}</p>
        <p class="primitive-pattern" lang={unitLang(primitive, "composition.pattern")}>{data.composition.pattern}</p>
        <p lang={unitLang(primitive, "composition.example")}>{data.composition.example}</p>
      </div>
      <div>
        <span>{ui("ENGINEERING & COGNITION / 工程与认知注意点")}</span>
        <ul>{data.considerations.map((note) => <li lang={unitLang(primitive, "considerations")}>{note}</li>)}</ul>
      </div>
    </div>

    <div class="definition-grid">
      <h2>{ui("Distinctions / 概念边界")}</h2>
      <p lang={unitLang(primitive, "distinctions")}>{data.distinctions}</p>
    </div>

    <div class="definition-grid">
      <h2>{ui("Ownership & priority / 归属与优先级")}</h2>
      <div>
        <p><strong>{ui(owner.label)}.</strong> <span lang={unitLang(primitive, "ownership.rationale")}>{data.ownership.rationale}</span></p>
        <p><strong>{data.priority.level} · <span lang={unitLang(primitive, "priority.scope")}>{data.priority.scope}</span>.</strong> <span lang={unitLang(primitive, "priority.rationale")}>{data.priority.rationale}</span></p>
      </div>
    </div>

    {related.length > 0 && (
      <nav class="related-section" aria-label={`${data.term}: related primitives`}>
        <p class="eyebrow">{ui("COMBINE WITH / 关联原语")}</p>
        <h2>{ui("Related primitives")}</h2>
        <ul class="primitive-links">
          {related.map((entry) => <li><a href={pathWithBase(`/primitives/${entry.id}/`)} lang="en">{entry.data.term}</a></li>)}
        </ul>
      </nav>
    )}

    <nav class="related-section" aria-label={`${data.term}: concepts`}>
      <p class="eyebrow">{ui("IN THE LEXICON /")} {linkedConcepts.length} {ui("CONCEPTS")}</p>
      <h2>{ui("Concepts using this primitive")}</h2>
      {linkedConcepts.length > 0
        ? <ul class="primitive-links">{linkedConcepts.map((concept) => <li><a href={pathWithBase(`/concepts/${concept.id}/`)} lang="en">{concept.data.term}</a></li>)}</ul>
        : <p>{ui("No linked concepts yet.")}</p>}
    </nav>

    <SpeakingCardLinks cards={linkedSpeakingCards} headingId={`${primitive.id}-speaking-cards`} />

    <details class="primitive-sources">
      <summary>{ui("Sources & editorial basis / 来源依据")}</summary>
      <ul>{data.sources.map((source) => (
        <li>
          {source.url ? <a href={source.url} lang={source.title === "系统设计哲学的跨学科理论框架与可组合原语集" ? "zh-CN" : "en"}>{source.title}</a> : <cite lang={source.title === "系统设计哲学的跨学科理论框架与可组合原语集" ? "zh-CN" : "en"}>{source.title}</cite>}
          <span lang={source.section.startsWith("最终原语集") || source.section.startsWith("C. 来自旧标签") ? "zh-CN" : "en"}>. {source.section}. </span>{ui(source.basis === "report-synthesis" ? "Adapted research synthesis" : "Editorial synthesis")}; {ui(source.verification === "unverified" ? "not independently verified" : "verified")}.
        </li>
      ))}</ul>
    </details>

    <a class="primitive-back" href={pathWithBase(`/primitives/#${layerId}`)}>{ui("Back to primitive directory ↑")}</a>
    <RecordNavigation kind="primitives" previous={previous} next={next} />
  </article>
</StarlightPage>

<style>
  .primitive-stamps { display: flex; flex-wrap: wrap; gap: var(--lex-space-2); }
  .primitive-stamps .status-stamp { white-space: nowrap; }
  .primitive-detail .primitive-definition + .primitive-definition { margin-top: var(--lex-space-6); }
  .primitive-definition p { margin-top: 0; }
  .primitive-practice { margin-top: var(--lex-space-8); }
  .primitive-practice span { font-weight: 800; font-family: var(--sl-font-mono); letter-spacing: 0.06em; }
  .primitive-practice ul { padding-inline-start: 1.2rem; margin-bottom: 0; }
  .primitive-practice li + li { margin-top: var(--lex-space-2); }
  .primitive-pattern { padding: var(--lex-space-4); background: var(--lex-paper-deep); font-family: var(--sl-font-mono); font-size: var(--lex-text-small); overflow-wrap: anywhere; }
  .primitive-detail .related-section { margin-top: var(--lex-space-12); }
  .primitive-detail .related-section h2 { margin-bottom: var(--lex-space-4); }
  .primitive-links { display: flex; flex-wrap: wrap; gap: var(--lex-space-2) var(--lex-space-6); list-style: none; padding: 0; }
  .primitive-links li { margin: 0; }
  .primitive-links a, .primitive-back { display: inline-flex; align-items: center; min-height: var(--lex-control-height); }
  .primitive-sources { margin-top: var(--lex-space-8); color: var(--lex-muted); font-size: var(--lex-text-small); }
  .primitive-sources summary { min-height: var(--lex-control-height); padding-block: 0.6rem; cursor: pointer; font-weight: 700; }
  .primitive-back { margin-top: var(--lex-space-6); }
  @media (max-width: 50rem) {
    .primitive-stamps { gap: 0.4rem; }
  }
</style>
