---
import { getLocalizedConcepts } from '../lib/localized-catalog';
import { routeLocale, localePath, uiFor } from '../lib/locale';
import StarlightPage from '../components/LocalizedPage.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from '../components/LanguageSelect.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ConceptList from '../components/ConceptList.astro';
import ResourceIcon from '../components/ResourceIcon.astro';
import { categoryRegistry, pathWithBase as canonicalExportPath } from '../lib/catalog';
const locale = routeLocale(Astro.url);
const ui = uiFor(locale);
const pathWithBase = (path: string) => localePath(path, locale);

const concepts = await getLocalizedConcepts(locale);
const featuredSlugs = ['context-engineering', 'thin-kernel', 'bounded-autonomy', 'harness', 'inspectable-agency'];
const featured = featuredSlugs.map((slug) => concepts.find((concept) => concept.id === slug)).filter(Boolean);
const tasks = [
  { kind: 'concept' as const, title: 'Understand', description: 'Find the meaning and boundaries of a concept.', label: 'Concepts', href: '/concepts/' },
  { kind: 'primitive' as const, title: 'Design', description: 'Explore the building blocks of a system.', label: 'Primitives', href: '/primitives/' },
  { kind: 'speaking-guide' as const, title: 'Explain', description: 'Prepare a clear explanation or discussion.', label: 'Speaking Cards', href: '/speaking-card/' },
  { kind: 'skill-map' as const, title: 'Apply', description: 'Choose skills for the task at hand.', label: 'Skill Maps', href: '/skill-maps/' },
];

---

<StarlightPage frontmatter={{ title: ui('AI Native Lexicon'), template: 'splash', editUrl: false }}>
  <div class="lexicon-home" id="lexicon-content" tabindex="-1">
    <section class="lexicon-hero">
      <div class="hero-kicker">
        <nav aria-label={ui('Primary')}>
          <a href={pathWithBase('/concepts/')}>{ui("Concepts")}</a>
          <a href={pathWithBase('/categories/')}>{ui("Categories")}</a>
          <a href={pathWithBase('/primitives/')}>{ui("Primitives")}</a>
          <a href={pathWithBase('/search/')}>{ui("Search")}</a>
          <a href={pathWithBase('/speaking-card/')}>{ui("Speaking Card")}</a>
          <a href={pathWithBase('/skill-maps/')}>{ui("Skill Maps")}</a>
        </nav>
        <span>{ui("EDITION 0.1")}</span>
        <div class="home-native-controls" data-pagefind-ignore><ThemeSelect /><LanguageSelect /></div>
      </div>
      <div class="hero-grid brand-hero-grid">
        <div class="brand-hero-copy">
          <p class="eyebrow">{ui("Navigate AI-native systems.")}</p>
          <h1 lang="en">AI Native<br/><em>Lexicon</em></h1>
          <div class="hero-manifesto">
          <p>{ui("An open lexicon of concepts, patterns and mental models shaping AI-native software engineering.")}</p>
          <div class="hero-actions">
            <a class="button-primary" href={pathWithBase('/concepts/')}>{ui("Browse all concepts")} <span>↗</span></a>
            <a class="text-link" href={pathWithBase('/about/')}>{ui("Read the editorial stance")}</a>
          </div>
          </div>
        </div>
        <img class="brand-mascot" src={canonicalExportPath('/brand/rider-mascot-491.webp')} srcset={`${canonicalExportPath('/brand/rider-mascot-320.webp')} 320w, ${canonicalExportPath('/brand/rider-mascot-491.webp')} 491w`} sizes="(max-width: 50rem) 180px, 245px" width="491" height="626" alt="" aria-hidden="true" fetchpriority="high" />
      </div>
      <div class="hero-ledger" aria-label={ui('Lexicon statistics')}>
        <div><strong>{concepts.length}</strong><span>{ui("working concepts")}</span></div>
        <div><strong>{String(categoryRegistry.length).padStart(2, '0')}</strong><span>{ui("domains of practice")}</span></div>
        <div><strong>YAML</strong><span>{ui("canonical content")}</span></div>
        <div><strong>{locale === "zh-CN" ? "开放" : "OPEN"}</strong><span>{ui("built in public")}</span></div>
      </div>
    </section>

    <section class="home-tasks" aria-labelledby="home-tasks-title">
      <h2 id="home-tasks-title">{ui('What do you want to do?')}</h2>
      <div class="task-entries">{tasks.map((task) => <a href={pathWithBase(task.href)} data-task-entry={task.kind}>
        <ResourceIcon kind={task.kind} size={32} />
        <h3>{ui(task.title)}</h3><p>{ui(task.description)}</p><span>{ui(task.label)} <span aria-hidden="true">↗</span></span>
      </a>)}</div>
    </section>

    <section class="home-section home-featured">
      <div class="section-heading compact">
        <p>{ui("01 / START HERE")}</p>
        <h2>{ui("Five ideas that")}<br/>{ui("change the frame.")}</h2>
      </div>
      <ConceptList concepts={featured as typeof concepts} />
      <a class="view-all" href={pathWithBase('/concepts/')}>{ui("View the complete A–Z index")} <span>↗</span></a>
    </section>

    <section class="home-section">
      <div class="section-heading">
        <p>{ui("02 / ORIENTATION")}</p>
        <h2>{ui("A field guide,")}<br/>{ui("not a fixed canon.")}</h2>
        <p class="section-note">{ui("These are working definitions for builders. Maturity labels make disagreement visible; relationships keep each term from becoming an island.")}</p>
      </div>
      <CategoryGrid concepts={concepts} />
      <a class="view-all" href={pathWithBase('/categories/')}>{ui("Browse all categories")} <span>↗</span></a>
    </section>

    <section class="dataset-callout">
      <p>{ui("03 / BUILT FOR HUMANS + AGENTS")}</p>
      <h2>{ui("One source.")}<br/>{ui("Many projections.")}</h2>
      <div>
        <p>{ui("Canonical content is edited in YAML. The website, field search and machine exports are projections of those validated records; taxonomy enums are generated from the YAML registry.")}</p>
        <div class="projection-line"><span>YAML</span><b>→</b><span>WEB</span><b>→</b><span>JSON</span><b>→</b><span>LLM</span></div>
        <a class="button-dark" href={canonicalExportPath('/dataset.json')}>{ui("Open the dataset")} <span>↗</span></a>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  /* Native splash pages have no sidebar menu to expose these mobile controls. */
  .home-native-controls {
    display: flex;
    flex-basis: 100%;
    align-items: center;
    gap: var(--lex-space-4);
    font-family: var(--sl-font);
    font-size: var(--sl-text-base);
    letter-spacing: normal;
  }
  @media (min-width: 50rem) { .home-native-controls { display: none; } }
</style>
