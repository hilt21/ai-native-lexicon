---
import { resourceIcons } from '../lib/brand';
import { pathWithBase } from '../lib/catalog';
import type { SearchKind } from '../lib/field-search';
interface Props { kind: SearchKind; size?: number }
const { kind, size = 24 } = Astro.props;
const file = resourceIcons[kind];
---
<span class="resource-icon" aria-hidden="true" data-resource-icon={kind} style={`width:${size}px;height:${size}px`}>
  <img class="icon-light" src={pathWithBase(`/brand/${file}.svg`)} alt="" width={size} height={size} />
  <img class="icon-dark" src={pathWithBase(`/brand/${file}-dark.svg`)} alt="" width={size} height={size} />
</span>
<style>
  .resource-icon { display: inline-flex; flex: none; vertical-align: middle; }
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .icon-dark { display: none; }
  :global([data-theme='dark']) .icon-light { display: none; }
  :global([data-theme='dark']) .icon-dark { display: block; }
</style>
