---
import type { Concept } from '../lib/catalog';
import ConceptRow from './ConceptRow.astro';

interface Props {
  concepts: Concept[];
  showCategory?: boolean;
}

const { concepts, showCategory = true } = Astro.props;
---

<div class="concept-list">
  {concepts.map((concept, index) => (
    <ConceptRow concept={concept} number={index + 1} showCategory={showCategory} />
  ))}
</div>
