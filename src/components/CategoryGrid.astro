---
import type { Concept } from '../lib/catalog';
import { categoryMeta, pathWithBase } from '../lib/catalog';

interface Props { concepts: Concept[]; headingLevel?: 'h2' | 'h3' }
const { concepts, headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="category-grid">
  {Object.entries(categoryMeta).map(([category, meta], index) => {
    const count = concepts.filter((concept) => concept.data.category === category).length;
    return (
      <a class="category-cell" href={pathWithBase(`/categories/${meta.slug}/`)}>
        <span class="category-index">0{index + 1} / {meta.code}</span>
        <Heading>{category}</Heading>
        <p>{meta.description}</p>
        <span class="category-foot"><span>{count} concepts</span><span>Explore ↗</span></span>
      </a>
    );
  })}
</div>
