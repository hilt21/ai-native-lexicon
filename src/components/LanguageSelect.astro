---
import Select from '@astrojs/starlight/components/Select.astro';
import { pageFragments } from '../lib/page-fragments';
import { localePath, rootPath } from '../lib/locale';
const root = rootPath(Astro.url);
const selected = Astro.locals.starlightRoute.locale;
const englishFragments = await pageFragments(root, 'en');
const chineseFragments = await pageFragments(root, 'zh-CN');
---
<lexicon-language-select data-fragments={JSON.stringify({ [localePath(root, "en")]: englishFragments, [localePath(root, "zh-CN")]: chineseFragments })}>
  <Select icon="translate" label={Astro.locals.t('languageSelect.accessibleLabel')} width="7em" options={[
    { value: localePath(root, 'en'), label: 'English', selected: selected === undefined },
    { value: localePath(root, 'zh-CN'), label: '简体中文', selected: selected === 'zh-cn' },
  ]} />
</lexicon-language-select>
<script>
  class LexiconLanguageSelect extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      if (!select) return;
      select.addEventListener('change', () => {
        const target = new URL(select.value, location.origin);
        target.search = location.search;
        let fragment = '';
        try { fragment = decodeURIComponent(location.hash.slice(1)); } catch { /* Invalid percent encoding has no valid target. */ }
        const fragments: Record<string, string[]> = JSON.parse(this.dataset.fragments!);
        if (fragment && fragments[target.pathname]?.includes(fragment)) target.hash = location.hash;
        location.href = target.href;
      });
      window.addEventListener('pageshow', () => { select.selectedIndex = select.querySelector<HTMLOptionElement>('option[selected]')?.index ?? 0; });
    }
  }
  customElements.define('lexicon-language-select', LexiconLanguageSelect);
</script>
