---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import ResourceIcon from './ResourceIcon.astro';
import { resourceIcons, resourceKindForRoute } from '../lib/brand';
import { rootPath, routeLocale, uiFor } from '../lib/locale';
const kind = resourceKindForRoute(rootPath(Astro.url));
const ui = uiFor(routeLocale(Astro.url));
---
{kind && <p class="resource-heading"><ResourceIcon kind={kind} /><span>{ui(resourceIcons[kind].label)}</span></p>}
{Astro.locals.skillMapTitleParts ? <h1 id="_top">{Astro.locals.skillMapTitleParts.map((part) => <span lang={part.lang}>{part.text}</span>)}</h1> : Astro.locals.lexiconPage?.titleLanguage ? <h1 id="_top" lang={Astro.locals.lexiconPage.titleLanguage}>{Astro.locals.starlightRoute.entry.data.title}</h1> : <DefaultPageTitle />}
<style>
  @layer starlight.core {
    h1 { margin-top: 1rem; font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); font-weight: 600; color: var(--sl-color-white); }
  }
</style>
