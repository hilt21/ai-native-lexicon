---
import StarlightPage, { type StarlightPageProps } from '@astrojs/starlight/components/StarlightPage.astro';
import { getLocalizedCatalog } from '../lib/localized-catalog';
import { routeLocale, rootPath, uiFor } from '../lib/locale';
import { getSkillMaps, mapPageTranslation } from '../lib/skill-maps';
type Props = StarlightPageProps;
const locale = routeLocale(Astro.url);
const route = rootPath(Astro.url);
const ui = uiFor(locale);
const catalog = await getLocalizedCatalog('zh-CN');
const conceptId = /^\/concepts\/([^/]+)\/$/.exec(route)?.[1];
const primitiveId = /^\/primitives\/([^/]+)\/$/.exec(route)?.[1];
const categoryId = /^\/categories\/([^/]+)\/$/.exec(route)?.[1];
const categoryRecord = categoryId ? catalog.categories.find((entry: { id: string }) => entry.id === categoryId) : undefined;
const record = conceptId ? catalog.concepts.find((entry) => entry.id === conceptId) : primitiveId ? catalog.primitives.find((entry) => entry.id === primitiveId) : undefined;
if ((conceptId || primitiveId) && !record) throw new Error(`Unknown record route: ${route}`);
const guideReady = route === '/speaking-card/' ? catalog.speakingCards.every((r: { coreTranslated: boolean }) => r.coreTranslated) : true;
const mapId = /^\/skill-maps\/([^/]+)\//.exec(route)?.[1];
const map = mapId ? (await getSkillMaps('zh-CN')).find((m) => m.id === mapId) : undefined;
const mapState = map ? mapPageTranslation(map, route) : undefined;
const mapsReady = route === '/skill-maps/' ? (await getSkillMaps('zh-CN')).every((m) => mapPageTranslation(m, `/skill-maps/${m.id}/`).coreTranslated) : true;
const categoryNavigation = route === '/' || route === '/categories/';
const layerNavigation = route === '/primitives/';
const navigationTranslated = categoryNavigation ? catalog.categories.every((entry) => ['label', 'description'].every((path) => entry.units[path].status === 'reviewed')) : layerNavigation ? catalog.layers.every((entry) => entry.units.label.status === 'reviewed') : true;
Astro.locals.lexiconPage = { rootPath: route, chineseIndexable: record ? record.coreTranslated : categoryRecord ? categoryRecord.coreTranslated : mapState ? mapState.coreTranslated : navigationTranslated && mapsReady && guideReady, titleLanguage: record ? 'en' : categoryRecord ? locale === 'en' ? 'en' : categoryRecord.units.label.actualLang : undefined };
const taxonomy = route === '/' || route === '/categories/' ? catalog.categories : route === '/primitives/' ? catalog.layers : [];
const taxonomyCoverage = taxonomy.reduce((total, entry) => { for (const key of ['translated', 'total', 'missing', 'draft', 'stale'] as const) total[key] += entry.coverage[key]; return total; }, { translated: 0, total: 0, missing: 0, draft: 0, stale: 0 });
const guideCoverage = route === '/speaking-card/' ? catalog.speakingCards.reduce((total, entry) => { for (const key of ['translated', 'total', 'missing', 'draft', 'stale'] as const) total[key] += entry.coverage[key]; return total; }, { translated: 0, total: 0, missing: 0, draft: 0, stale: 0 }) : undefined;
if (locale === 'zh-CN') Astro.locals.publicationNotes = {
  coverage: categoryRecord?.coverage ?? record?.coverage ?? mapState?.coverage ?? guideCoverage ?? (taxonomyCoverage.total > 0 ? taxonomyCoverage : undefined),
  englishShareImages: route === '/speaking-card/',
};
const frontmatter = { ...Astro.props.frontmatter, title: ui(Astro.props.frontmatter.title), description: Astro.props.frontmatter.description ? ui(Astro.props.frontmatter.description) : undefined };
---
<StarlightPage {...Astro.props} frontmatter={frontmatter}>
  <slot />
</StarlightPage>
