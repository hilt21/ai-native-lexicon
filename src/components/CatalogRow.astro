---
import type { SearchField, SearchKind } from '../lib/field-search';
import ResourceIcon from './ResourceIcon.astro';

interface Props {
  searchIdentity?: string;
  searchType?: SearchKind;
  resourceType?: SearchKind;
  searchFields?: SearchField[];
  titleLanguage?: string;
  summaryLanguage?: string;
  secondaryParts?: { text: string; lang?: string }[];
  href: string;
  title: string;
  secondary: string;
  marker: string;
  summary: string;
  searchText?: string;
  number?: string;
  showMarker?: boolean;
}

const { searchIdentity, searchType, resourceType, searchFields, titleLanguage, summaryLanguage, secondaryParts, href, title, secondary, marker, summary, searchText, number, showMarker = true } = Astro.props;
---

<a
  class:list={['concept-row', { 'concept-row-unclassified': !showMarker, 'concept-row-search': number === undefined, 'catalog-search-row': !!searchFields }]}
  href={href}
  data-search={searchText}
  data-search-identity={searchIdentity}
  data-search-type={searchType}
  data-search-title={searchFields ? title : undefined}
  data-search-fields={searchFields ? JSON.stringify(searchFields) : undefined}
>
  {number !== undefined && <span class="concept-number">{number}</span>}
  <span class="concept-name"><strong lang={titleLanguage}>{(searchType || resourceType) && <ResourceIcon kind={(searchType || resourceType)!} size={20} />}{title}</strong><span>{secondaryParts ? secondaryParts.map((part) => <span lang={part.lang}>{part.text}</span>) : secondary}</span></span>
  {showMarker && <span class="concept-category">{marker}</span>}
  <span class="concept-summary" lang={summaryLanguage}>{summary}</span>
  {searchFields && <span class="search-match" hidden><span data-match-label></span><span data-match-context></span></span>}
  <span class="concept-arrow" aria-hidden="true">↗</span>
</a>
