---
interface Props {
  titleLanguage?: string;
  summaryLanguage?: string;
  secondaryParts?: { text: string; lang?: string }[];
  href: string;
  title: string;
  secondary: string;
  marker: string;
  summary: string;
  searchText?: string;
  number?: string;
  showMarker?: boolean;
}

const { titleLanguage, summaryLanguage, secondaryParts, href, title, secondary, marker, summary, searchText, number, showMarker = true } = Astro.props;
---

<a
  class:list={['concept-row', { 'concept-row-unclassified': !showMarker, 'concept-row-search': number === undefined }]}
  href={href}
  data-search={searchText}
>
  {number !== undefined && <span class="concept-number">{number}</span>}
  <span class="concept-name"><strong lang={titleLanguage}>{title}</strong><span>{secondaryParts ? secondaryParts.map((part) => <span lang={part.lang}>{part.text}</span>) : secondary}</span></span>
  {showMarker && <span class="concept-category">{marker}</span>}
  <span class="concept-summary" lang={summaryLanguage}>{summary}</span>
  <span class="concept-arrow" aria-hidden="true">↗</span>
</a>
