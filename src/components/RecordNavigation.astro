---
import { routeLocale, localePath, uiFor } from '../lib/locale';
interface Entry { id: string; data: { term: string } }
interface Props { kind: 'concepts' | 'primitives'; previous?: Entry; next?: Entry }
const { kind, previous, next } = Astro.props;
const kindLabel = kind === 'concepts' ? 'Concept' : 'Primitive';

const locale = routeLocale(Astro.url);
const ui = uiFor(locale);
const pathWithBase = (path: string) => localePath(path, locale);
const label = ui(kindLabel);
---

<nav class="record-navigation" aria-label={`${label} A–Z`}>
  <p class="eyebrow">{ui("CONTINUE READING")} / {label.toUpperCase()} A–Z</p>
  <div>
    {previous && <a rel="prev" href={pathWithBase(`/${kind}/${previous.id}/`)}><span>{ui("← Previous")}</span><strong lang="en">{previous.data.term}</strong></a>}
    {next && <a rel="next" href={pathWithBase(`/${kind}/${next.id}/`)}><span>{ui("Next →")}</span><strong lang="en">{next.data.term}</strong></a>}
  </div>
</nav>
