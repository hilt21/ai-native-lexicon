---
import { routeLocale, localePath } from '../lib/locale';
import { unitLang } from '../lib/localized-catalog';
import type { LocalizedConcept as Concept } from '../lib/localized-catalog';
import { categoryMeta } from '../lib/catalog';
import CatalogRow from './CatalogRow.astro';

interface Props {
  concept: Concept;
  number?: number;
  showCategory?: boolean;
  searchText?: string;
}

const { concept, number, showCategory = true, searchText } = Astro.props;

const locale = routeLocale(Astro.url);
const pathWithBase = (path: string) => localePath(path, locale);
---

<CatalogRow
  href={pathWithBase(`/concepts/${concept.id}/`)}
  title={concept.data.term}
  titleLanguage="en"
  summaryLanguage={unitLang(concept, "summary")}
  secondaryParts={[{ text: concept.data.zh, lang: "zh-CN" }]}
  secondary={concept.data.zh}
  marker={categoryMeta[concept.data.category].code}
  summary={concept.data.summary}
  searchText={searchText}
  number={number === undefined ? undefined : String(number).padStart(2, '0')}
  showMarker={showCategory}
/>
