---
import type { Concept } from '../lib/catalog';
import { categoryMeta, pathWithBase } from '../lib/catalog';
import CatalogRow from './CatalogRow.astro';

interface Props {
  concept: Concept;
  number?: number;
  showCategory?: boolean;
  searchText?: string;
}

const { concept, number, showCategory = true, searchText } = Astro.props;
---

<CatalogRow
  href={pathWithBase(`/concepts/${concept.id}/`)}
  title={concept.data.term}
  secondary={concept.data.zh}
  marker={categoryMeta[concept.data.category].code}
  summary={concept.data.summary}
  searchText={searchText}
  number={number === undefined ? undefined : String(number).padStart(2, '0')}
  showMarker={showCategory}
/>
