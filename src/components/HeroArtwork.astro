---
import { pathWithBase } from '../lib/catalog';
const imageSet = (theme: 'light' | 'dark', mobile = false) => {
  const directory = mobile ? 'hero-mobile' : theme === 'dark' ? 'hero-v3' : 'hero-v2';
  const width = mobile ? 480 : 340;
  return `image-set(url("${pathWithBase(`/brand/${directory}/rider-${theme}-${width}.webp`)}") 1x, url("${pathWithBase(`/brand/${directory}/rider-${theme}-${width * 2}.webp`)}") 2x)`;
};
---
<div
  class="hero-artwork"
  data-hero-artwork
  aria-hidden="true"
  style={`--hero-artwork-light:${imageSet('light')};--hero-artwork-dark:${imageSet('dark')};--hero-artwork-mobile-light:${imageSet('light', true)};--hero-artwork-mobile-dark:${imageSet('dark', true)}`}
></div>
<style>
  .hero-artwork {
    width: var(--hero-artwork-width);
    max-width: 100%;
    aspect-ratio: 1111 / 1416;
    justify-self: start;
    transform: translateY(-20px);
    background-image: var(--hero-artwork-light);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }
  :global([data-theme='dark']) .hero-artwork { background-image: var(--hero-artwork-dark); }
  @media (max-width: 50rem) {
    .hero-artwork { transform: none; background-image: var(--hero-artwork-mobile-light); }
    :global([data-theme='dark']) .hero-artwork { background-image: var(--hero-artwork-mobile-dark); }
  }
  @media (min-width: 50rem) and (max-width: 75rem) {
    .hero-artwork { transform: none; }
  }
</style>
