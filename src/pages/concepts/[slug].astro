---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import RecordNavigation from '../../components/RecordNavigation.astro';
import CopyDefinition from '../../components/CopyDefinition.astro';
import RelatedConcepts from '../../components/RelatedConcepts.astro';
import SpeakingCardLinks from '../../components/SpeakingCardLinks.astro';
import { getSpeakingCards } from '../../lib/speaking-cards';
import { contentBranch } from '../../lib/repository.mjs';
import { categoryMeta, getConcepts, getPrimitives, pathWithBase } from '../../lib/catalog';

export async function getStaticPaths() {
  const [concepts, primitiveCatalog] = await Promise.all([getConcepts(), getPrimitives()]);
  const primitivesById = new Map(primitiveCatalog.map((entry) => [entry.id, entry]));
  return concepts.map((concept, index) => {
    const primitives = concept.data.primitives.map((slug) => {
      const primitive = primitivesById.get(slug);
      if (!primitive) throw new Error(`${concept.id}: missing primitive ${slug}`);
      return primitive;
    });
    return { params: { slug: concept.id }, props: { concept, concepts, primitives, previous: concepts[index - 1], next: concepts[index + 1] } };
  });
}

const { concept, concepts, primitives, previous, next } = Astro.props;
const meta = categoryMeta[concept.data.category];
const repository = process.env.GITHUB_REPOSITORY;
const editUrl = repository
  ? `https://github.com/${repository}/edit/${contentBranch}/src/data/concepts/${concept.id}.yaml`
  : false;
const related = concept.data.related
  .map((slug: string) => concepts.find((entry: typeof concept) => entry.id === slug))
  .filter((entry: typeof concept | undefined): entry is typeof concept => entry !== undefined);
const linkedSpeakingCards = (await getSpeakingCards()).filter((card) => card.concepts.includes(concept.id));
---

<StarlightPage frontmatter={{
  title: concept.data.term,
  description: concept.data.summary,
  editUrl,
  tableOfContents: false,
}}>
  <article class="concept-detail">
    <header class="concept-masthead">
      <div>
        <a href={pathWithBase(`/categories/${meta.slug}/`)}>{meta.code} / {concept.data.category}</a>
        <p class="concept-zh">{concept.data.zh}</p>
      </div>
      <span class:list={['status-stamp', `status-${concept.data.status}`]}>{concept.data.status}</span>
    </header>

    <p class="concept-deck">{concept.data.summary}</p>

    <div class="definition-grid">
      <h2>Working definition</h2>
      <CopyDefinition name={concept.data.term} statusId={`${concept.id}-definition-copy`}><p data-definition-body>{concept.data.definition}</p></CopyDefinition>
    </div>
    <div class="definition-grid">
      <h2>Why it matters</h2>
      <p>{concept.data.why_it_matters}</p>
    </div>
    <div class="practice-grid">
      <div><span>USE IT WHEN</span><p>{concept.data.when_to_use}</p></div>
      <div><span>WATCH FOR</span><p>{concept.data.anti_pattern}</p></div>
    </div>

    {concept.data.examples.length > 0 && (
      <section class="reading-examples">
        <h2>Examples</h2>
        <p class="reading-note">Editorial illustrations; these examples are not verified factual reports.</p>
        {concept.data.examples.map((item) => <div class="definition-grid"><h3>{item.context}</h3><p>{item.example}</p></div>)}
      </section>
    )}
    {concept.data.distinguish_from.length > 0 && (
      <section class="reading-distinction">
        <h2>Distinguish from</h2>
        {concept.data.distinguish_from.map((item) => {
          const target = concepts.find((entry) => entry.id === item.target);
          if (!target) throw new Error(`${concept.id}: missing distinction target ${item.target}`);
          return <div class="definition-grid"><h3><a href={pathWithBase(`/concepts/${target.id}/`)}>{target.data.term}</a></h3><p>{item.distinction}</p></div>;
        })}
      </section>
    )}

    {concept.data.sources.length > 0 && <section class="concept-sources"><h2>Sources</h2><ul>{concept.data.sources.map((source) => <li><a href={source.url}>{source.title}</a></li>)}</ul></section>}

    {primitives.length > 0 && (
      <nav class="primitive-tags" aria-label="Related primitives">
        <p class="eyebrow">PRIMITIVES / 原语</p>
        <div class="tag-line">
          {primitives.map((primitive) => (
            <a href={pathWithBase(`/primitives/${primitive.id}/`)}>{primitive.data.term}</a>
          ))}
        </div>
      </nav>
    )}

    <SpeakingCardLinks cards={linkedSpeakingCards} headingId={`${concept.id}-speaking-cards`} />

    <section class="related-section">
      <p class="eyebrow">FOLLOW THE THREAD</p>
      <h2>Related concepts</h2>
      <RelatedConcepts concepts={related} />
    </section>
    <RecordNavigation kind="concepts" previous={previous} next={next} />
  </article>
</StarlightPage>
