---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getConcepts, getPrimitives } from '../lib/catalog';
import CatalogRow from '../components/CatalogRow.astro';
import { getSpeakingCards } from '../lib/speaking-cards';
import { getSkillMaps } from '../lib/skill-maps';
import { catalogSearchRecords } from '../lib/search-catalog';
import { searchKinds } from '../lib/field-search';
const [concepts, primitives, speakingCards, maps] = await Promise.all([getConcepts(), getPrimitives(), getSpeakingCards(), getSkillMaps()]);
const records = catalogSearchRecords(concepts, primitives, speakingCards, maps);
---

<StarlightPage frontmatter={{ title: 'Search', description: 'Search knowledge, speaking guides and skill maps by name, idea, or relationships.', editUrl: false, tableOfContents: false }}>
  <div class="search-panel">
    <label for="concept-search">Search the working vocabulary</label>
    <div class="search-input-wrap">
      <span aria-hidden="true">⌕</span>
      <input id="concept-search" type="search" placeholder="Try “context”, “permission”, or “handoff”…" autocomplete="off" aria-describedby="search-help" />
    </div>
    <div class="search-controls">
      <label for="search-type">Content type
        <select id="search-type"><option value="">All types</option>{searchKinds.map((kind) => <option value={kind.value}>{kind.label}</option>)}</select>
      </label>
      <button id="search-clear" type="button">Clear</button>
    </div>
    <p id="search-help">Find English and Chinese names, aliases, concept definitions and linked terms. Results count unique records. Header Search, when available, searches full page text and counts pages or fragments.</p>
    <p id="search-count" aria-live="polite">Showing all {records.length} entries</p>
  </div>
  <div class="search-results" id="search-results">
    {records.map((record) => <CatalogRow
      {...record}
      marker={searchKinds.find((kind) => kind.value === record.type)!.label}
      searchIdentity={record.identity} searchType={record.type} searchFields={record.fields}
      searchText={record.fields.map((field) => field.value).join(' ').toLowerCase()}
    />)}
  </div>
  <p class="search-empty" id="search-empty" hidden>No matching entry yet. Try a broader word or propose a missing term.</p>
  <script>
    import { matchRecords, validSearchKind, type SearchRecord, type SearchField } from '../lib/field-search';
    const input = document.querySelector<HTMLInputElement>('#concept-search')!;
    const type = document.querySelector<HTMLSelectElement>('#search-type')!;
    const count = document.querySelector<HTMLElement>('#search-count')!;
    const empty = document.querySelector<HTMLElement>('#search-empty')!;
    const container = document.querySelector<HTMLElement>('#search-results')!;
    const entries = [...container.querySelectorAll<HTMLElement>('[data-search]')];
    function isSearchField(value: unknown): value is SearchField {
      return typeof value === 'object' && value !== null
        && 'label' in value && typeof value.label === 'string'
        && 'value' in value && typeof value.value === 'string'
        && (!('context' in value) || typeof value.context === 'boolean')
        && (!('lang' in value) || typeof value.lang === 'string');
    }
    function readSearchRecord(entry: HTMLElement): SearchRecord {
      const { searchIdentity: identity, searchTitle: title, searchFields: serialized } = entry.dataset;
      const kind = validSearchKind(entry.dataset.searchType ?? '');
      const context = `Catalog search record "${identity ?? '(missing identity)'}"`;
      if (!identity || title === undefined || serialized === undefined || !kind) throw new Error(`${context}: missing metadata or invalid content type`);
      let fields: unknown;
      try { fields = JSON.parse(serialized); }
      catch (error) { throw new Error(`${context}: malformed serialized fields`, { cause: error }); }
      if (!Array.isArray(fields) || !fields.every(isSearchField)) throw new Error(`${context}: invalid serialized field shape`);
      return { identity, title, type: kind, fields };
    }
    const records = entries.map(readSearchRecord);
    const byIdentity = new Map(records.map((record, index) => [record.identity, entries[index]!]));
    function updateSearch() {
      const matches = matchRecords(records, input.value, type.value);
      for (const entry of entries) entry.hidden = true;
      for (const match of matches) {
        const entry = byIdentity.get(match.record.identity)!;
        entry.hidden = false;
        const explanation = entry.querySelector<HTMLElement>('.search-match')!;
        explanation.hidden = !input.value.trim();
        entry.querySelector<HTMLElement>('[data-match-label]')!.textContent = `Matched: ${match.label}`;
        const context = entry.querySelector<HTMLElement>('[data-match-context]')!;
        context.textContent = match.excerpt;
        if (match.language) context.lang = match.language; else context.removeAttribute('lang');
        container.append(entry);
      }
      count.textContent = input.value.trim() || type.value ? `${matches.length} matching ${matches.length === 1 ? 'entry' : 'entries'}` : `Showing all ${matches.length} entries`;
      empty.hidden = matches.length !== 0;
      const url = new URL(location.href);
      if (input.value) url.searchParams.set('q', input.value); else url.searchParams.delete('q');
      if (type.value) url.searchParams.set('type', type.value); else url.searchParams.delete('type');
      if (url.href !== location.href) history.replaceState(history.state, '', url);
    }
    function restoreSearch() {
      const url = new URL(location.href);
      input.value = url.searchParams.get('q') ?? '';
      type.value = validSearchKind(url.searchParams.get('type') ?? '');
      updateSearch();
    }
    input.addEventListener('input', updateSearch);
    type.addEventListener('change', updateSearch);
    document.querySelector('#search-clear')!.addEventListener('click', () => { input.value = ''; type.value = ''; updateSearch(); input.focus(); });
    window.addEventListener('popstate', restoreSearch);
    window.addEventListener('pageshow', restoreSearch);
    restoreSearch();
  </script>
</StarlightPage>
