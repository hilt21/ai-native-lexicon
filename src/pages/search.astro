---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getConcepts, getPrimitives, pathWithBase } from '../lib/catalog';
import ConceptRow from '../components/ConceptRow.astro';
import CatalogRow from '../components/CatalogRow.astro';
import { getSpeakingCards } from '../lib/speaking-cards';
import { getSkillMaps, mapLink } from '../lib/skill-maps';
const [concepts, primitives, speakingCards, maps] = await Promise.all([getConcepts(), getPrimitives(), getSpeakingCards(), getSkillMaps()]);
const mapResults = maps.flatMap((map) => [
  { href: mapLink(map.id), title: map.data.title, summary: map.data.summary, secondary: 'Skill Map', marker: 'MAP', number: 'M', search: `${map.data.scope} ${map.data.audience.join(' ')}` },
  ...map.data.nodes.map((n) => ({ href: mapLink(map.id, `nodes/${n.id}/`), title: n.title, summary: n.summary, secondary: `${map.data.title} · ${map.data.taxonomy.types.find((t) => t.id === n.type)?.label}${n.status === 'retired' ? ' · Retired' : ''}`, marker: 'ITEM', number: 'N', search: `${n.when_to_use.join(' ')} ${n.tags.join(' ')} ${map.data.taxonomy.clusters.filter((c) => c.id === n.primary_cluster || n.secondary_clusters.includes(c.id)).map((c) => c.label).join(' ')}` })),
  ...map.data.journeys.map((j) => ({ href: mapLink(map.id, `journeys/${j.id}/`), title: j.title, summary: j.summary, secondary: `${map.data.title} · Task journey${j.status === 'retired' ? ' · Retired' : ''}`, marker: 'TASK', number: 'J', search: j.when_to_use.join(' ') })),
]);
const primitiveNames = new Map(primitives.map(({ id, data }) => [id, `${data.term} ${data.zh}`]));
const conceptNames = new Map(concepts.map(({ id, data }) => [id, `${data.term} ${data.zh}`]));
---

<StarlightPage frontmatter={{ title: 'Search', description: 'Search knowledge, speaking guides and skill maps by name, idea, or relationships.', editUrl: false, tableOfContents: false }}>
  <div class="search-panel">
    <label for="concept-search">Search the working vocabulary</label>
    <div class="search-input-wrap">
      <span aria-hidden="true">⌕</span>
      <input id="concept-search" type="search" placeholder="Try “context”, “permission”, or “handoff”…" autocomplete="off" />
      <kbd>/</kbd>
    </div>
    <p id="search-count" aria-live="polite">Showing all {concepts.length + primitives.length + speakingCards.length + mapResults.length} entries</p>
  </div>

  <div class="search-results" id="search-results">
    {mapResults.map((result) => <CatalogRow {...result} searchText={`${result.title} ${result.summary} ${result.secondary} ${result.search}`.toLowerCase()} />)}
    {concepts.map((concept) => (
      <ConceptRow
        concept={concept}
        searchText={`${concept.data.term} ${concept.data.zh} ${concept.data.category} ${concept.data.summary} ${concept.data.primitives.map((id) => `${id} ${primitiveNames.get(id)}`).join(' ')}`.toLowerCase()}
      />
    ))}
    {primitives.map((primitive) => (
      <CatalogRow
        href={pathWithBase(`/primitives/#${primitive.id}`)}
        title={primitive.data.term}
        secondary={primitive.data.zh}
        marker={primitive.data.priority.level}
        summary={primitive.data.summary}
        searchText={`${primitive.data.term} ${primitive.data.zh} ${primitive.data.summary} ${primitive.data.layer} ${primitive.id}`.toLowerCase()}
        number="P"
      />
    ))}
    {speakingCards.map((card) => (
      <CatalogRow
        href={pathWithBase(`/speaking-card/#card-${String(card.number).padStart(2, '0')}`)}
        title={card.title}
        secondary={`Speaking Guide · Card ${String(card.number).padStart(2, '0')}`}
        marker="GUIDE"
        summary={card.coreIdea}
        searchText={`${card.title} ${card.coreIdea} ${card.concepts.map((slug) => `${slug} ${conceptNames.get(slug)}`).join(' ')} ${card.primitives.map((slug) => `${slug} ${primitiveNames.get(slug)}`).join(' ')}`.toLowerCase()}
        number="S"
      />
    ))}
  </div>

  <p class="search-empty" id="search-empty" hidden>No matching entry yet. Try a broader word or propose a missing term.</p>

  <script>
    const input = document.querySelector<HTMLInputElement>('#concept-search');
    const count = document.querySelector<HTMLElement>('#search-count');
    const empty = document.querySelector<HTMLElement>('#search-empty');
    const entries = [...document.querySelectorAll<HTMLElement>('[data-search]')];

    function updateSearch() {
      const words = (input?.value ?? '').toLowerCase().trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const entry of entries) {
        const haystack = entry.dataset.search ?? '';
        const match = words.every((word) => haystack.includes(word));
        entry.hidden = !match;
        if (match) visible += 1;
      }
      if (count) count.textContent = words.length ? `${visible} matching ${visible === 1 ? 'entry' : 'entries'}` : `Showing all ${entries.length} entries`;
      if (empty) empty.hidden = visible !== 0;
    }

    input?.addEventListener('input', updateSearch);
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== input) {
        event.preventDefault();
        input?.focus();
      }
    });
  </script>
</StarlightPage>
