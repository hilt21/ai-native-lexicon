---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PrimitiveRow from '../components/PrimitiveRow.astro';
import { getPrimitives } from '../lib/catalog';
import { primitiveLayers } from '../lib/primitive-schema.mjs';
import { primitiveLayerId, primitiveOwners, primitivePriorities, type PrimitiveLayer } from '../lib/primitive-presentation';

const primitives = await getPrimitives();
const primitivesByLayer = new Map<PrimitiveLayer, typeof primitives>(primitiveLayers.map((layer: PrimitiveLayer) => [layer, []]));
for (const primitive of primitives) primitivesByLayer.get(primitive.data.layer)?.push(primitive);
---

<StarlightPage frontmatter={{ title: 'Primitives', description: 'Composable building blocks for understanding and designing AI-native systems.', editUrl: false, tableOfContents: false }}>
  <div class="page-intro primitive-page-intro">
    <p class="eyebrow">{primitives.length} BUILDING BLOCKS / 原语</p>
    <div>
      <p>A primitive is a basic unit of understanding or construction within a stated domain and level of abstraction. These entries form a working design language; a concept can involve several primitives.</p>
      <p class="primitive-source-note">Adapted from <cite>系统设计哲学的跨学科理论框架与可组合原语集</cite>, with Goal and Evidence retained from this lexicon. The supplied report is a research synthesis; its external references have not been independently verified.</p>
    </div>
  </div>

  <details class="primitive-guide">
    <summary>How to read priority and ownership / 优先级与归属</summary>
    <dl>
      {Object.entries(primitivePriorities).map(([level, meta]) => <><dt>{level} {meta.label}</dt><dd>{meta.description}</dd></>)}
      {Object.values(primitiveOwners).map((meta) => <><dt>{meta.label}</dt><dd>{meta.description}</dd></>)}
    </dl>
  </details>

  <nav class="primitive-layer-nav" aria-label="Primitive layers">
    {primitiveLayers.map((layer: PrimitiveLayer) => <a href={`#${primitiveLayerId(layer)}`}>{layer}</a>)}
  </nav>

  <div class="primitive-layers">
    {primitiveLayers.map((layer: PrimitiveLayer) => {
      const members = primitivesByLayer.get(layer) ?? [];
      const layerId = primitiveLayerId(layer);
      return (
        <section class="primitive-layer" id={layerId} aria-labelledby={`${layerId}-title`}>
          <header class="primitive-layer-heading">
            <h2 id={`${layerId}-title`}>{layer}</h2>
            <span>{String(members.length).padStart(2, '0')} primitives</span>
          </header>
          <div class="primitive-layer-list">
            {members.map((primitive) => <PrimitiveRow primitive={primitive} />)}
          </div>
        </section>
      );
    })}
  </div>
</StarlightPage>

<style>
  .primitive-page-intro > div > p:first-child {
    max-width: 40rem;
    margin: 0;
    font-family: var(--lex-font-display);
    font-size: var(--lex-text-lead);
    font-weight: 500;
    line-height: 1.45;
  }
  .primitive-source-note { margin: var(--lex-space-4) 0 0; color: var(--lex-muted); font-size: var(--lex-text-small); line-height: 1.55; }
  .primitive-guide { margin-bottom: var(--lex-space-8); }
  .primitive-guide summary { min-height: var(--lex-control-height); padding-block: 0.6rem; cursor: pointer; font-weight: 700; }
  .primitive-guide dl { display: grid; grid-template-columns: minmax(10rem, 0.4fr) minmax(0, 1fr); margin: 0; }
  .primitive-guide dt, .primitive-guide dd { margin: 0; padding-block: var(--lex-space-2); border-top: 1px solid var(--lex-line); }
  .primitive-guide dt { font-weight: 700; }
  .primitive-guide dd { color: var(--lex-muted); }
  .primitive-layer-nav { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-bottom: var(--lex-space-12); padding-block: var(--lex-space-4); border-block: 1px solid var(--lex-line); }
  .primitive-layer-nav a { display: inline-flex; min-height: var(--lex-control-height); align-items: center; color: var(--lex-ink); font-weight: 700; text-decoration-color: var(--lex-acid); text-underline-offset: 0.2rem; }
  .primitive-layer { margin-block: var(--lex-space-12); scroll-margin-top: 6rem; }
  .primitive-layer-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--lex-space-4); padding-top: var(--lex-space-4); border-top: 1px solid var(--lex-line); }
  .primitive-layer-heading h2 { margin: 0; font-family: var(--lex-font-display); font-size: var(--lex-text-card); font-weight: 600; letter-spacing: -0.03em; line-height: 1.2; }
  .primitive-layer-heading span { color: var(--lex-muted); font-family: var(--sl-font-mono); font-size: var(--lex-text-label); white-space: nowrap; }
  .primitive-layer-list { container-type: inline-size; }
  @media (max-width: 50rem) {
    .primitive-page-intro { grid-template-columns: minmax(0, 1fr); }
    .primitive-guide dl { grid-template-columns: minmax(0, 1fr); }
    .primitive-guide dd { padding-top: 0; border-top: 0; }
  }
</style>
