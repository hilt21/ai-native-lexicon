---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { primitiveLayers } from '../lib/primitive-schema.mjs';
import { getConcepts, getPrimitives, getPrimitiveDefinitions, pathWithBase } from '../lib/catalog';

const [concepts, primitives] = await Promise.all([getConcepts(), getPrimitives()]);
const conceptsById = new Map(concepts.map((concept) => [concept.id, concept]));
const primitivesById = new Map(primitives.map((primitive) => [primitive.id, primitive]));
const conceptsByPrimitive = new Map(primitives.map(({ id }) => [id, [] as typeof concepts]));
for (const concept of concepts) {
  for (const slug of concept.data.primitives) conceptsByPrimitive.get(slug)?.push(concept);
}
const owners = {
  llm: { label: 'LLM', description: 'Suited to probabilistic reasoning.' },
  executor: { label: 'Executor · 执行器', description: 'Prefer code, rules, databases, state machines, or tools.' },
  hybrid: { label: 'Hybrid · 混合', description: 'LLMs may propose or explain; deterministic mechanisms constrain, preserve, or commit. Implementation ownership does not transfer human decision authority.' },
};
const priorities = {
  P0: { label: 'Core · 核心', description: 'Explicitly consider in most system designs. AI-specific entries state their narrower scope.' },
  P1: { label: 'Foundation · 基础', description: 'A strong default: model explicitly where applicable.' },
  P2: { label: 'Situational · 情境', description: 'Becomes important in complex, adaptive, AI, or high-risk systems.' },
};
---

<StarlightPage frontmatter={{ title: 'Primitives', description: 'Composable building blocks for understanding and designing AI-native systems.', editUrl: false, tableOfContents: false }}>
  <div class="primitive-intro">
    <p class="eyebrow">{primitives.length} BUILDING BLOCKS / 原语</p>
    <p>A primitive is a basic unit of understanding or construction within a stated domain and level of abstraction. These entries form a working design language; a concept can involve several primitives.</p>
    <p>Adapted from <cite>系统设计哲学的跨学科理论框架与可组合原语集</cite>, with Goal and Evidence retained from this lexicon. The report is a supplied research synthesis; its external references have not been independently verified here.</p>
    <details class="primitive-legend">
      <summary>How to read priority and ownership / 优先级与归属</summary>
      <dl>
        {Object.entries(priorities).map(([level, meta]) => <><dt>{level} {meta.label}</dt><dd>{meta.description}</dd></>)}
        {Object.values(owners).map((meta) => <><dt>{meta.label}</dt><dd>{meta.description}</dd></>)}
      </dl>
    </details>
  </div>

  <nav class="primitive-index" id="primitive-index" aria-label="Primitive index">
    {primitiveLayers.map((layer) => (
      <div>
        <h2>{layer}</h2>
        <ul>
          {primitives.filter(({ data }) => data.layer === layer).map((primitive) => (
            <li><a href={`#${primitive.id}`}>{primitive.data.term} <span lang="zh">{primitive.data.zh}</span></a></li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  {primitives.map((primitive) => {
    const { data, id } = primitive;
    const definitions = getPrimitiveDefinitions(primitive, conceptsById);
    const linkedConcepts = conceptsByPrimitive.get(id) ?? [];
    const related = data.related.map((slug) => {
      const entry = primitivesById.get(slug);
      if (!entry) throw new Error(`${id}: missing related primitive ${slug}`);
      return entry;
    });
    return (
      <article class="primitive-entry" id={id} aria-labelledby={`${id}-title`}>
        <header>
          <p class="eyebrow">{data.layer}</p>
          <h2 id={`${id}-title`}>{data.term} <span lang="zh">{data.zh}</span></h2>
          <p class="primitive-summary">{data.summary}</p>
          <p class="primitive-meta"><span>{data.priority.level} · {priorities[data.priority.level].label}</span><span>{owners[data.ownership.kind].label}</span></p>
        </header>
        <dl class="primitive-fields">
          <div><dt>Definition / 定义</dt><dd>{definitions.map((definition) => (
            <div class="primitive-definition">
              <p><strong>{definition.name}.</strong> {definition.text}</p>
              {definition.concept && <a href={pathWithBase(`/concepts/${definition.concept}/`)}>Read the concept →</a>}
            </div>
          ))}</dd></div>
          <div><dt>Scope / 适用范围</dt><dd>{data.scope}</dd></div>
          <div><dt>Use & composition / 用途与组合</dt><dd><p>{data.usage}</p><p class="primitive-pattern">{data.composition.pattern}</p><p>{data.composition.example}</p></dd></div>
          <div><dt>Considerations / 注意点</dt><dd><ul>{data.considerations.map((note) => <li>{note}</li>)}</ul></dd></div>
          <div><dt>Distinctions / 概念边界</dt><dd>{data.distinctions}</dd></div>
          <div><dt>Ownership / 归属</dt><dd><strong>{owners[data.ownership.kind].label}.</strong> {data.ownership.rationale}</dd></div>
          <div><dt>Priority / 优先级</dt><dd><strong>{data.priority.level} · {data.priority.scope}.</strong> {data.priority.rationale}</dd></div>
        </dl>
        {related.length > 0 && <nav aria-label={`${data.term}: related primitives`}>
          <p class="eyebrow">COMBINE WITH / 关联原语</p>
          <ul class="primitive-links">{related.map((entry) => <li><a href={`#${entry.id}`}>{entry.data.term}</a></li>)}</ul>
        </nav>}
        <nav aria-label={`${data.term}: concepts`}>
          <p class="eyebrow">IN THE LEXICON / {linkedConcepts.length} CONCEPTS</p>
          {linkedConcepts.length > 0
            ? <ul class="primitive-links">{linkedConcepts.map((concept) => <li><a href={pathWithBase(`/concepts/${concept.id}/`)}>{concept.data.term}</a></li>)}</ul>
            : <p>No linked concepts yet.</p>}
        </nav>
        <details class="primitive-sources">
          <summary>Sources & editorial basis / 来源依据</summary>
          <ul>{data.sources.map((source) => (
            <li>
              {source.url ? <a href={source.url}>{source.title}</a> : <cite>{source.title}</cite>}
              {' — '}{source.section}. {source.basis === 'report-synthesis' ? 'Adapted research synthesis' : 'Editorial synthesis'}; {source.verification === 'unverified' ? 'not independently verified' : 'verified'}.
            </li>
          ))}</ul>
        </details>
        <a class="primitive-back" href="#primitive-index">Back to index ↑</a>
      </article>
    );
  })}
</StarlightPage>

<style>
  .primitive-intro { max-width: var(--lex-reading-width); }
  .primitive-intro > p { line-height: var(--lex-leading-body); }
  .primitive-legend { margin-block: var(--lex-space-6); }
  summary { cursor: pointer; min-height: var(--lex-control-height); padding-block: 0.6rem; font-weight: 700; }
  .primitive-legend dt { font-weight: 700; margin-top: 1rem; }
  .primitive-legend dd { margin: 0.35rem 0 1rem; }
  .primitive-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--lex-space-6); border-block: 1px solid var(--lex-line); padding-block: var(--lex-space-8); }
  .primitive-index h2 { margin: 0; font-size: var(--lex-text-body); }
  .primitive-index ul { padding-left: 1.25rem; }
  .primitive-index a { display: inline-block; padding-block: 0.35rem; }
  .primitive-index span { color: var(--lex-muted); font-size: var(--lex-text-small); }
  .primitive-entry { padding-block: var(--lex-space-12); border-bottom: 1px solid var(--lex-line); scroll-margin-top: 6rem; overflow-wrap: anywhere; }
  .primitive-entry:target { border-top: 3px solid var(--lex-ink); }
  .primitive-entry h2 { margin: 0; font-size: var(--lex-text-section); line-height: 1.25; }
  .primitive-entry h2 span { display: block; color: var(--lex-muted); font-size: var(--lex-text-body); margin-top: 0.5rem; }
  .primitive-summary { font-size: var(--lex-text-lead); }
  .primitive-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .primitive-meta span { border: 1px solid var(--lex-line); padding: 0.3rem 0.6rem; font-size: var(--lex-text-small); }
  .primitive-fields > div { display: grid; grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr); gap: var(--lex-space-6); padding-block: var(--lex-space-6); border-top: 1px solid var(--lex-line); }
  .primitive-fields dt { font-size: var(--lex-text-small); font-weight: 700; }
  .primitive-fields dd { margin: 0; min-width: 0; line-height: var(--lex-leading-body); }
  .primitive-fields p:first-child, .primitive-fields ul { margin-top: 0; }
  .primitive-fields p:last-child { margin-bottom: 0; }
  .primitive-definition + .primitive-definition { margin-top: var(--lex-space-6); }
  .primitive-pattern { font-family: var(--sl-font-mono); background: var(--lex-paper-deep); padding: 1rem; font-size: var(--lex-text-small); }
  .primitive-entry nav { margin-block: var(--lex-space-8); }
  .primitive-entry nav .eyebrow { margin-bottom: 0.5rem; }
  .primitive-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; list-style: none; padding: 0; }
  .primitive-links li { margin: 0; }
  .primitive-links a, .primitive-back { display: inline-block; padding-block: 0.4rem; }
  .primitive-sources { font-size: var(--lex-text-small); color: var(--lex-muted); }
  #primitive-index { scroll-margin-top: 6rem; }
  @media (max-width: 50rem) {
    .primitive-index, .primitive-fields > div { grid-template-columns: minmax(0, 1fr); }
    .primitive-fields > div { gap: 0.6rem; }
  }
</style>
