---
import SkillMapPage from '../../../../components/SkillMapPage.astro';
import { getSkillMaps, mapLink, sourceLink, orderedJourneys, type SkillMap, type MapNode } from '../../../../lib/skill-maps';
export async function getStaticPaths() { return (await getSkillMaps()).flatMap((map) => map.data.nodes.map((node) => ({ params: { map: map.id, node: node.id }, props: { map, node } }))); }
interface Props { map: SkillMap; node: MapNode }
const { map, node } = Astro.props;
const groups = map.data.taxonomy.relation_types.flatMap((type) => ['outgoing', 'incoming'].map((direction) => ({ label: direction === 'outgoing' ? type.outgoing_label : type.incoming_label, edges: map.data.relations.filter((edge) => edge.type === type.id && (direction === 'outgoing' ? edge.from : edge.to) === node.id).map((edge) => ({ edge, target: map.data.nodes.find((n) => n.id === (direction === 'outgoing' ? edge.to : edge.from))! })) }))).filter((group) => group.edges.length);
const journeys = orderedJourneys(map).filter((j) => j.variants.some((v) => v.steps.some((s) => s.nodes.includes(node.id))));
---
<SkillMapPage map={map} title={node.title} description={node.summary} section="nodes">
  <div class="map-detail">
    <article>
      <p class="map-item-type">{map.data.taxonomy.types.find((t) => t.id === node.type)?.label} {node.status === 'retired' && '· Retired'}</p>
      <p class="page-intro">{node.summary}</p>
      {node.status === 'retired' && <aside class="map-retirement"><h2>Retired</h2><p>{node.retirement_note}</p>{node.replaced_by && <a href={mapLink(map.id, `nodes/${node.replaced_by}/`)}>替代条目：{map.data.nodes.find((n) => n.id === node.replaced_by)!.title}</a>}</aside>}
      {node.when_to_use.length > 0 && <section><h2>什么时候用</h2><ul>{node.when_to_use.map((text) => <li>{text}</li>)}</ul></section>}
      {node.solves.length > 0 && <section><h2>解决什么问题</h2><ul>{node.solves.map((text) => <li>{text}</li>)}</ul></section>}
      {node.mechanism && <section><h2>工作机制</h2><p>{node.mechanism}</p></section>}
      {(node.inputs.length > 0 || node.outputs.length > 0) && <div class="map-io">{[{ title: '输入', items: node.inputs }, { title: '输出', items: node.outputs }].filter((g) => g.items.length).map((g) => <section><h2>{g.title}</h2><ul>{g.items.map((s) => <li>{s}</li>)}</ul></section>)}</div>}
      {groups.map((group) => <section><h2>{group.label}</h2><ul>{group.edges.map(({ edge, target }) => <li><a href={mapLink(map.id, `nodes/${target.id}/`)}>{target.title}</a>{target.status === 'retired' && ' · Retired'}{edge.note && <span> — {edge.note}</span>}</li>)}</ul></section>)}
      {journeys.length > 0 && <section><h2>相关任务路径</h2><ul>{journeys.map((j) => <li><a href={mapLink(map.id, `journeys/${j.id}/`)}>{j.title}</a>{j.status === 'retired' && ' · Retired'}</li>)}</ul></section>}
      {node.handoffs.length > 0 && <details><summary>交接说明</summary><ul>{node.handoffs.map((s) => <li>{s}</li>)}</ul></details>}
      {node.official_description && <details><summary>Official description</summary><p>{node.official_description}</p></details>}
      {node.source_refs.length > 0 && <section><h2>Sources</h2><ul>{node.source_refs.map((ref) => <li><a href={sourceLink(map, ref)}>{ref.path}</a></li>)}</ul><p class="map-scope">官方描述已对照来源；机制与用途为编辑解读。</p></section>}
    </article>
    <nav class="map-local-index" aria-label="Items in this map"><h2>In this map</h2><a href={mapLink(map.id, 'nodes/')}>Search all items</a><ul>{map.data.nodes.filter((n) => n.status === 'active' || n.id === node.id).map((n) => <li><a href={mapLink(map.id, `nodes/${n.id}/`)} aria-current={n.id === node.id ? 'page' : undefined}>{n.title}</a></li>)}</ul></nav>
  </div>
</SkillMapPage>
