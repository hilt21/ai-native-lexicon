---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getSkillMaps, mapLink } from '../../lib/skill-maps';
const maps = await getSkillMaps();
---
<StarlightPage frontmatter={{ title: 'Skill Maps', description: 'Choose and combine skills from a task.', editUrl: false, tableOfContents: false }}>
  <div class="skill-map">
    <p class="page-intro">从你要完成的工作出发，了解一套技能体系的入口、能力与实践路径。</p>
    <div class="map-index">{maps.map((map) => <a class="map-index-item" href={mapLink(map.id)}><h2>{map.data.title}</h2><p>{map.data.summary}</p><p class="map-scope">{map.data.audience.join(' / ')}</p><span>{map.data.nodes.filter((n) => n.status === 'active').length} items · {map.data.journeys.filter((j) => j.status === 'active').length} task journeys</span><p class="map-scope">{map.data.current_sources.map((id) => { const s = map.data.sources.find((s) => s.id === id)!; return `${s.version ?? id} · Checked ${s.verified_at}`; }).join('; ')}</p></a>)}</div>
    {maps.length === 0 && <p>No maps yet.</p>}
  </div>
</StarlightPage>
