{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "coreIdea": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "keyLines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "realCase": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "discussionQuestion": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "endingLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ending": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "number",
    "title",
    "concepts",
    "primitives",
    "coreIdea",
    "keyLines",
    "realCase",
    "discussionQuestion",
    "endingLabel",
    "ending"
  ],
  "additionalProperties": false,
  "title": "AI Native Lexicon speaking card"
}
